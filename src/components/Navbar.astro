---
import { contactConfig } from '../data/siteConfig';

const navItems = [
  { label: 'HOME', href: '#home' },
  { label: 'FACILITIES', href: '#facilities' },
  { label: 'PRICING', href: '#pricing' },
  { label: 'GALLERY', href: '#gallery' },
  { label: 'LOCATION', href: '#location' },
];
---

<header
  id="main-nav"
  class="fixed top-0 left-0 right-0 z-50 w-full transition-all duration-300 bg-transparent text-white border-b border-white/10"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="#home" class="flex flex-col group text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-white rounded-md">
      <span id="nav-brand-title" class="font-extrabold text-xl sm:text-3xl tracking-tight text-white group-hover:text-emerald-300 transition-colors leading-none">
        BENIYA
      </span>
      <span id="nav-brand-subtitle" class="text-[9px] sm:text-xs font-bold tracking-[0.25em] text-emerald-300 uppercase mt-0.5 sm:mt-1 leading-none transition-colors">
        CRICKET ARENA
      </span>
    </a>

    <!-- Desktop Navigation Links (Untouched) -->
    <nav class="hidden md:flex items-center space-x-8" aria-label="Main Navigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="nav-link text-xs font-bold tracking-widest text-white/90 hover:text-white transition-colors uppercase py-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-white rounded"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Desktop Right Header Action -->
    <div class="hidden sm:flex items-center space-x-4">
      <a
        href="#pricing"
        class="inline-flex items-center gap-2 bg-[#1B4D3E] hover:bg-[#153E32] text-white text-xs font-bold uppercase tracking-wider px-5 py-3 rounded-lg shadow-md hover:shadow-lg transition-all duration-200 border border-emerald-600/30"
      >
        <span>BOOK NOW</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Mobile Hamburger Menu Button -->
    <div class="flex items-center md:hidden">
      <button
        id="mobile-menu-btn"
        type="button"
        class="p-2 -mr-2 text-white hover:text-emerald-300 focus:outline-none focus:ring-2 focus:ring-white rounded-lg"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <svg id="menu-icon-open" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-[#161916]/95 backdrop-blur-xl border-b border-white/10 px-5 pt-3 pb-6 space-y-3 shadow-2xl">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="mobile-nav-link block px-3 py-2.5 rounded-lg text-sm font-bold tracking-wider text-white hover:bg-white/10 hover:text-emerald-300 transition-colors uppercase"
      >
        {item.label}
      </a>
    ))}
    
    <div class="pt-4 border-t border-white/10 flex flex-col gap-2.5">
      <a
        href="#pricing"
        class="mobile-nav-link w-full inline-flex items-center justify-center gap-2 bg-[#1B4D3E] text-white font-bold text-sm py-3.5 rounded-lg shadow-md"
      >
        <span>BOOK NOW</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <a
        href={contactConfig.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full inline-flex items-center justify-center gap-2 bg-white/10 border border-white/20 text-white font-bold text-sm py-3 rounded-lg"
      >
        <span>BOOK ON WHATSAPP</span>
        <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  const nav = document.getElementById('main-nav');
  const brandTitle = document.getElementById('nav-brand-title');
  const brandSubtitle = document.getElementById('nav-brand-subtitle');
  const navLinks = document.querySelectorAll('.nav-link');
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  function updateNavbar() {
    if (window.scrollY > 25) {
      nav?.classList.remove('bg-transparent', 'text-white', 'border-white/10');
      nav?.classList.add('bg-[#FAFAF7]/95', 'backdrop-blur-md', 'text-[#161916]', 'border-[#E5E0D8]', 'shadow-sm');
      brandTitle?.classList.remove('text-white', 'group-hover:text-emerald-300');
      brandTitle?.classList.add('text-[#161916]', 'group-hover:text-[#1B4D3E]');
      brandSubtitle?.classList.remove('text-emerald-300');
      brandSubtitle?.classList.add('text-[#5A7865]');
      navLinks.forEach(link => {
        link.classList.remove('text-white/90', 'hover:text-white');
        link.classList.add('text-[#161916]', 'hover:text-[#1B4D3E]');
      });
      menuBtn?.classList.remove('text-white');
      menuBtn?.classList.add('text-[#161916]');
    } else {
      nav?.classList.add('bg-transparent', 'text-white', 'border-white/10');
      nav?.classList.remove('bg-[#FAFAF7]/95', 'backdrop-blur-md', 'text-[#161916]', 'border-[#E5E0D8]', 'shadow-sm');
      brandTitle?.classList.add('text-white', 'group-hover:text-emerald-300');
      brandTitle?.classList.remove('text-[#161916]', 'group-hover:text-[#1B4D3E]');
      brandSubtitle?.classList.add('text-emerald-300');
      brandSubtitle?.classList.remove('text-[#5A7865]');
      navLinks.forEach(link => {
        link.classList.add('text-white/90', 'hover:text-white');
        link.classList.remove('text-[#161916]', 'hover:text-[#1B4D3E]');
      });
      menuBtn?.classList.add('text-white');
      menuBtn?.classList.remove('text-[#161916]');
    }
  }

  window.addEventListener('scroll', updateNavbar, { passive: true });
  updateNavbar();

  function toggleMenu() {
    const isExpanded = menuBtn?.getAttribute('aria-expanded') === 'true';
    menuBtn?.setAttribute('aria-expanded', (!isExpanded).toString());
    mobileMenu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  }

  menuBtn?.addEventListener('click', toggleMenu);

  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      if (!mobileMenu?.classList.contains('hidden')) {
        toggleMenu();
      }
    });
  });
</script>
