---
import { reviews } from '../data/siteConfig';
---

<section class="texture-light py-12 sm:py-16 lg:py-24 bg-[#FAFAF7] border-b border-[#E5E0D8] relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="gsap-reveal text-center max-w-2xl mx-auto mb-8 sm:mb-16">
      <span class="inline-block text-xs font-bold tracking-[0.2em] text-[#5A7865] uppercase mb-2">
        COMMUNITY FEEDBACK
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#161916] tracking-tight mb-3 sm:mb-4">
        WHAT PLAYERS SAY
      </h2>
      <p class="text-xs sm:text-base text-[#5E665E]">
        Feedback from teams, captains, and regular weekend cricket groups in Varanasi.
      </p>
    </div>

    <!-- 3 Compact Testimonial Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
      {reviews.map((rev) => (
        <div class="gsap-card gsap-tilt group bg-white border border-[#E5E0D8] rounded-xl p-5 sm:p-7 flex flex-col justify-between shadow-xs hover:border-[#1B4D3E]/40 hover:-translate-y-1 hover:shadow-md transition-all duration-300">
          <div>
            <!-- Star Rating -->
            <div class="flex items-center gap-1 text-[#1B4D3E] mb-3 sm:mb-4">
              {Array.from({ length: rev.rating }).map(() => (
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>

            <!-- Review Quote -->
            <p class="text-xs sm:text-base text-[#161916] leading-relaxed mb-4 sm:mb-6 font-medium italic">
              "{rev.quote}"
            </p>
          </div>

          <!-- Author Info -->
          <div class="pt-3 sm:pt-4 border-t border-[#E5E0D8] flex items-center justify-between">
            <div>
              <p class="text-xs sm:text-sm font-bold text-[#161916]">{rev.author}</p>
              <p class="text-[11px] sm:text-xs text-[#5E665E]">{rev.role}</p>
            </div>
            <span class="text-[10px] sm:text-[11px] font-bold text-[#1B4D3E] bg-[#EBF3EF] px-2 py-0.5 rounded border border-[#1B4D3E]/15">
              Verified Player
            </span>
          </div>
        </div>
      ))}
    </div>


  </div>
</section>
