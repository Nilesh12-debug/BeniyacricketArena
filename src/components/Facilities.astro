---
import { facilitiesList } from '../data/siteConfig';
---

<section id="facilities" class="texture-cream py-12 sm:py-16 lg:py-24 bg-[#F4F0E8] border-b border-[#E5E0D8] relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="gsap-reveal text-center max-w-2xl mx-auto mb-8 sm:mb-16">
      <span class="inline-block text-xs font-bold tracking-[0.2em] text-[#5A7865] uppercase mb-2">
        FACILITIES & ADVANTAGES
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#161916] tracking-tight mb-3 sm:mb-4">
        WHY PLAY AT BENIYA?
      </h2>
      <p class="text-xs sm:text-base text-[#5E665E]">
        Designed specifically for cricket enthusiasts seeking true bounce, safety, and flexible match timings in Varanasi.
      </p>
    </div>

    <!-- 6 Facility Cards with Refined Hover Micro-Interactions -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
      {facilitiesList.map((facility, index) => (
        <div class="gsap-card gsap-tilt group bg-[#FFFFFF] border border-[#E5E0D8] rounded-xl p-5 sm:p-7 hover:border-[#1B4D3E]/50 hover:-translate-y-1.5 hover:shadow-lg hover:shadow-[#1B4D3E]/5 transition-all duration-300 flex flex-col justify-between cursor-default">
          <div>
            <!-- Minimal Icon Badge -->
            <div class="w-9 sm:w-10 h-9 sm:h-10 rounded-lg bg-[#EBF3EF] text-[#1B4D3E] group-hover:bg-[#1B4D3E] group-hover:text-white transition-colors duration-300 flex items-center justify-center mb-4 sm:mb-5 font-extrabold text-xs sm:text-sm border border-[#1B4D3E]/15">
              0{index + 1}
            </div>
            
            <h3 class="text-base sm:text-lg font-bold text-[#161916] group-hover:text-[#1B4D3E] transition-colors duration-200 tracking-tight mb-2 sm:mb-3">
              {facility.title}
            </h3>
            
            <p class="text-xs sm:text-sm text-[#5E665E] leading-relaxed">
              {facility.description}
            </p>
          </div>
        </div>
      ))}
    </div>


  </div>
</section>
