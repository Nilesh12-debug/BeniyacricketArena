---
import { siteImages } from '../data/siteConfig';
---

<section id="gallery" class="texture-light py-12 sm:py-16 lg:py-24 bg-[#FAFAF7] border-b border-[#E5E0D8] relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="reveal-group text-center max-w-2xl mx-auto mb-8 sm:mb-16">
      <span class="inline-block text-xs font-bold tracking-[0.2em] text-[#5A7865] uppercase mb-2">
        FACILITY TOUR
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#161916] tracking-tight mb-3 sm:mb-4">
        SEE THE ARENA
      </h2>
      <p class="text-xs sm:text-base text-[#5E665E]">
        Take a look at Beniya Cricket Arena before you book.
      </p>
    </div>

    <!-- Gallery Grid with Smooth Zoom & Contextual Badges -->
    <div class="reveal-group grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
      {siteImages.gallery.map((item) => (
        <div class="group bg-white border border-[#E5E0D8] rounded-xl overflow-hidden shadow-xs hover:shadow-xl hover:border-[#1B4D3E]/40 hover:-translate-y-1 transition-all duration-300">
          <div class="relative h-60 sm:h-72 overflow-hidden bg-[#E2DDD5]">
            <img
              src={item.url}
              alt={item.alt || `${item.title} at Beniya Cricket Arena`}
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
              loading="lazy"
            />
            
            <!-- Category Badge -->
            <span class="absolute top-3 left-3 bg-[#161916]/80 backdrop-blur-md text-white text-[10px] font-bold px-2.5 py-1 rounded uppercase tracking-wider border border-white/10">
              {item.category}
            </span>

            <!-- Subtle Hover View Indicator -->
            <span class="absolute bottom-3 right-3 bg-white/90 backdrop-blur-md text-[#161916] group-hover:bg-[#1B4D3E] group-hover:text-white text-[11px] font-bold px-2.5 py-1 rounded transition-colors duration-200 flex items-center gap-1 shadow-sm opacity-90 group-hover:opacity-100">
              <span>VIEW</span>
              <svg class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </span>
          </div>
          <div class="p-4 sm:p-5">
            <h3 class="text-base font-bold text-[#161916] group-hover:text-[#1B4D3E] transition-colors duration-200 mb-1">
              {item.title}
            </h3>
            <p class="text-xs text-[#5E665E] leading-relaxed">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
