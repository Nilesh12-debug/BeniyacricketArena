---
import { siteImages } from '../data/siteConfig';
---

<section class="texture-dark-net py-14 sm:py-20 lg:py-28 bg-[#161916] text-[#FAFAF7] relative overflow-hidden border-y border-[#2A302A]">
  
  <!-- Subtle Atmospheric Reflected Green Glow in Background -->
  <div class="absolute top-1/3 -left-32 w-96 h-96 rounded-full bg-[#1B4D3E]/20 blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-10 right-0 w-96 h-96 rounded-full bg-[#1B4D3E]/15 blur-[140px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left: Dark Editorial Message -->
      <div class="reveal-group lg:col-span-6 text-left">
        <div class="inline-flex items-center gap-2 mb-2 sm:mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span class="text-xs font-bold tracking-[0.25em] text-[#8A9E90] uppercase">
            NIGHT TURF FACILITY
          </span>
        </div>
        
        <h2 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight mb-3 sm:mb-6">
          CRICKET AFTER DARK.
        </h2>

        <!-- Subtle Forest Green Accent Line -->
        <div class="w-16 h-1 bg-gradient-to-r from-[#1B4D3E] to-emerald-500 rounded-full mb-4 sm:mb-6"></div>

        <p class="text-lg sm:text-2xl font-semibold text-[#EBF3EF] mb-3 sm:mb-6">
          Floodlit cricket. Your team. Your time.
        </p>

        <p class="text-xs sm:text-base text-[#B0B8B0] leading-relaxed mb-6 sm:mb-8 max-w-lg">
          Avoid the daytime heat and work schedules. Our arena is fully illuminated with precision glare-free LED floodlights, providing crystal clear visibility from bowler release to the boundary netting.
        </p>

        <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4">
          <a
            href="#pricing"
            class="btn-dark glow-forest-hover w-full sm:w-auto inline-flex items-center justify-center gap-2 font-bold text-sm bg-white text-[#161916] hover:bg-[#EBF3EF] px-6 py-3.5 min-h-[48px] rounded-lg transition-all duration-200"
          >
            <span>BOOK A NIGHT SLOT</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <span class="text-xs text-[#8A9E90] font-bold uppercase tracking-wider text-center sm:text-left">
            Floodlights Active Till 05:00 AM
          </span>
        </div>
      </div>

      <!-- Right: Action Photo in Night Play with Smooth Hover Depth -->
      <div class="reveal-group lg:col-span-6">
        <div class="relative rounded-2xl overflow-hidden border border-[#2A302A] shadow-2xl hover:border-[#1B4D3E]/60 transition-colors duration-300 bg-[#0F120F] group">
          <img
            src={siteImages.nightPlay}
            alt="Cricket match under night floodlights at Beniya Cricket Arena in Varanasi"
            class="w-full h-64 sm:h-[380px] lg:h-[460px] object-cover object-center group-hover:scale-103 transition-transform duration-700 ease-out"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#161916]/85 via-transparent to-transparent"></div>
          <div class="absolute bottom-3 left-3 right-3 sm:bottom-5 sm:left-5 sm:right-5 text-xs text-[#EBF3EF] flex items-center justify-between">
            <span class="font-bold text-[11px] sm:text-xs">Even Floodlight Coverage</span>
            <span class="bg-[#1B4D3E]/90 border border-emerald-500/30 px-2 py-0.5 sm:px-2.5 sm:py-1 rounded text-[10px] sm:text-[11px] font-semibold">24/7 Available</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
