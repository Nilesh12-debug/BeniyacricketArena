---
import { siteImages } from '../data/siteConfig';

const highlights = [
  "Spacious turf",
  "High enclosure",
  "Floodlit night play",
  "Open 24/7"
];
---

<section id="about" class="texture-light py-12 sm:py-16 lg:py-24 bg-[#FAFAF7] border-b border-[#E5E0D8] relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-center">
      
      <!-- Image First on Mobile, Left Column on Desktop -->
      <div class="gsap-reveal lg:col-span-6 order-1">
        <div class="gsap-tilt relative rounded-2xl overflow-hidden shadow-md hover:shadow-xl border border-[#E5E0D8] bg-[#E2DDD5] group transition-all duration-300">
          <img
            src={siteImages.about}
            alt="Batsman playing cricket inside the enclosed artificial turf at Beniya Cricket Arena in Varanasi"
            class="w-full h-64 sm:h-80 lg:h-[440px] object-cover object-center group-hover:scale-103 transition-transform duration-700 ease-out"
            loading="lazy"
          />
          <div class="absolute bottom-3 left-3 sm:bottom-4 sm:left-4 bg-white/95 backdrop-blur-md px-3 sm:px-4 py-1.5 sm:py-2 rounded-lg border border-[#E5E0D8] text-[11px] sm:text-xs font-semibold text-[#161916] shadow-sm">
            Dedicated Enclosed Cricket Facility · Beniya Bagh
          </div>
        </div>
      </div>

      <!-- Text Second on Mobile, Right Column on Desktop -->
      <div class="gsap-reveal lg:col-span-6 order-2 text-left">
        <span class="inline-block text-xs font-bold tracking-[0.2em] text-[#5A7865] uppercase mb-2 sm:mb-3">
          ABOUT BENIYA CRICKET ARENA
        </span>

        
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#161916] tracking-tight leading-tight mb-4 sm:mb-6">
          A CRICKET TURF BUILT FOR THE GAME.
        </h2>

        <p class="text-sm sm:text-base lg:text-lg text-[#5E665E] leading-relaxed mb-4 sm:mb-6">
          Beniya Cricket Arena is a premium cricket turf in Beniya Bagh, Varanasi, where players can enjoy matches, practice sessions and night cricket in a dedicated enclosed playing space.
        </p>

        <p class="text-xs sm:text-sm lg:text-base text-[#5E665E] leading-relaxed mb-6 sm:mb-8">
          Whether you are organizing a weekend match with friends, running a competitive local tournament, or booking regular team practice sessions, our facility provides reliable true bounce and full player protection.
        </p>

        <!-- Feature List -->
        <ul class="grid grid-cols-2 gap-2.5 sm:gap-3.5 mb-6 sm:mb-8">
          {highlights.map((item) => (
            <li class="flex items-center gap-2 sm:gap-3 text-xs sm:text-sm font-bold text-[#161916]">
              <span class="flex-shrink-0 w-4 sm:w-5 h-4 sm:h-5 rounded-full bg-[#EBF3EF] text-[#1B4D3E] flex items-center justify-center text-[10px] sm:text-xs shadow-2xs">
                ✓
              </span>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <!-- Action Button (Min 48px Height on Mobile) -->
        <div>
          <a
            href="#facilities"
            class="btn-primary w-full sm:w-auto inline-flex items-center justify-center gap-2 text-sm font-bold min-h-[48px] px-6"
          >
            <span>EXPLORE FACILITIES</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

      </div>

    </div>
  </div>
</section>
