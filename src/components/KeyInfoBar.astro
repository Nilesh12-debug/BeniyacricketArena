---
import { keyInfoStats } from '../data/siteConfig';
---

<section id="key-info" class="texture-cream bg-[#F4F0E8] py-10 sm:py-16 border-b border-[#E5E0D8] relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="gsap-reveal text-center max-w-2xl mx-auto mb-8 sm:mb-10">
      <p class="text-xs font-bold tracking-[0.2em] text-[#5A7865] uppercase mb-2">ARENA CAPABILITIES</p>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-[#161916] tracking-tight">
        EVERYTHING YOU NEED TO PLAY
      </h2>
    </div>

    <!-- 2x2 on Mobile, 4-col on Desktop -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6">
      {keyInfoStats.map((item) => (
        <div class="gsap-card gsap-tilt group bg-[#FAFAF7] border border-[#E5E0D8] rounded-xl p-4 sm:p-6 text-center hover:border-[#1B4D3E]/40 hover:-translate-y-1 hover:shadow-md transition-all duration-300 shadow-xs flex flex-col justify-between">
          <div>
            <span class="block text-xl sm:text-3xl lg:text-4xl font-extrabold text-[#1B4D3E] group-hover:scale-105 transition-transform duration-300 tracking-tight mb-1 sm:mb-2">
              {item.title}
            </span>
            <h3 class="text-xs sm:text-base font-bold text-[#161916] mb-1 sm:mb-2">
              {item.subtitle}
            </h3>
            <p class="text-[11px] sm:text-sm text-[#5E665E] leading-relaxed">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

