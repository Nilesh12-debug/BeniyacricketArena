---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import MobileBookingBar from '../../components/MobileBookingBar.astro';
import { contactConfig, seoConfig } from '../../data/siteConfig';
---

<Layout
  title={seoConfig.pages.contact.title}
  description={seoConfig.pages.contact.description}
  keywords={seoConfig.pages.contact.keywords}
>
  <Navbar />

  <main class="pt-32 pb-24 px-4 sm:px-8 lg:px-16 min-h-[85vh] flex flex-col justify-center">
    <div class="max-w-4xl mx-auto w-full text-center space-y-8">
      <span class="text-xs font-mono font-bold tracking-[0.3em] text-[#C7FF00] uppercase">
        {contactConfig.area.toUpperCase()} · {contactConfig.city.toUpperCase()}
      </span>

      <h1 class="text-6xl sm:text-8xl md:text-9xl lg:text-[10rem] font-extrabold uppercase font-headline tracking-tighter text-[#F5F5F2] leading-[0.82] select-none">
        READY<br />
        <span class="text-transparent bg-clip-text bg-gradient-to-b from-white via-[#F5F5F2] to-white/40">
          TO PLAY?
        </span>
      </h1>

      <p class="text-lg sm:text-2xl text-[#8E8E93] font-light max-w-lg mx-auto leading-relaxed">
        Contact Beniya Cricket Arena directly to check availability and reserve your game.
      </p>

      <!-- Direct Contact Conversion Actions -->
      <div class="pt-4 flex flex-wrap items-center justify-center gap-4 sm:gap-6">
        <a
          href={contactConfig.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary text-xs sm:text-sm"
        >
          <span>WHATSAPP TO BOOK</span>
          <span>→</span>
        </a>

        <a
          href={contactConfig.phoneHref}
          class="btn-secondary text-xs sm:text-sm"
        >
          <span>CALL NOW</span>
          <span>→</span>
        </a>

        <a
          href={contactConfig.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary text-xs sm:text-sm"
        >
          <span>GET DIRECTIONS ↗</span>
        </a>
      </div>

      <!-- Verified Venue Address Card -->
      <div class="mt-16 max-w-md mx-auto p-8 rounded-3xl bg-[#111111] border border-white/10 text-center space-y-3">
        <div class="text-[10px] font-mono uppercase tracking-[0.25em] text-[#C7FF00]">
          BENIYA BAGH · VARANASI
        </div>
        <div class="text-xl font-bold uppercase font-headline text-white">
          {contactConfig.name}
        </div>
        <div class="text-xs text-[#8E8E93] font-light">
          {contactConfig.fullAddress}
        </div>
        <div class="pt-3">
          <span class="text-xs font-mono text-[#8E8E93]">
            Open Daily for Games · Call or WhatsApp to Book
          </span>
        </div>
      </div>
    </div>
  </main>

  <Footer />
  <MobileBookingBar />
</Layout>
