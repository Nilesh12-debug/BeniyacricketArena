---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import MobileBookingBar from '../../components/MobileBookingBar.astro';
import { contactConfig, seoConfig, experienceStories, siteImages } from '../../data/siteConfig';
---

<Layout
  title={seoConfig.pages.experience.title}
  description={seoConfig.pages.experience.description}
  keywords={seoConfig.pages.experience.keywords}
>
  <Navbar />

  <main class="pt-32 pb-20">
    <!-- 1. Cinematic Hero -->
    <section class="px-4 sm:px-8 lg:px-16 py-12 max-w-7xl mx-auto">
      <div class="space-y-4 max-w-3xl">
        <span class="text-xs font-mono uppercase tracking-[0.3em] text-[#C7FF00] block">
          NIGHT CRICKET · VARANASI
        </span>
        <h1 class="text-6xl sm:text-8xl md:text-9xl lg:text-[10.5rem] font-extrabold uppercase font-headline tracking-tighter text-[#F5F5F2] leading-[0.82]">
          PLAY AFTER<br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#C7FF00] via-[#C7FF00] to-white/60">
            DARK.
          </span>
        </h1>
        <p class="text-xl sm:text-2xl text-[#8E8E93] font-light pt-2">
          Under the Varanasi floodlights, every match feels like a championship game.
        </p>
      </div>

      <!-- Large Hero Visual Banner -->
      <div class="mt-12 rounded-3xl overflow-hidden border border-white/10 aspect-[21/9] max-h-[540px] w-full bg-[#121212]">
        <img
          src={siteImages.night}
          alt="Night cricket floodlights at Beniya Cricket Arena"
          class="w-full h-full object-cover filter brightness-[0.85] contrast-[1.1]"
          loading="eager"
        />
      </div>
    </section>

    <!-- 2. Four Cinematic Pillars (LIGHTS. SPACE. ENERGY. THE GAME.) -->
    <section class="px-4 sm:px-8 lg:px-16 py-16 max-w-7xl mx-auto border-t border-white/10 space-y-28">
      {experienceStories.map((story, idx) => {
        const isReversed = idx % 2 !== 0;
        return (
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-center">
            <div class={`lg:col-span-8 ${isReversed ? 'lg:order-2' : 'lg:order-1'}`}>
              <div class="relative rounded-3xl overflow-hidden border border-white/10 aspect-[16/10] bg-[#121212] group">
                <img
                  src={story.image}
                  alt={`Beniya Cricket Arena - ${story.tag}`}
                  class="w-full h-full object-cover filter brightness-[0.82] contrast-[1.08] group-hover:scale-105 transition-all duration-700 ease-out"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#080808]/80 via-transparent to-transparent"></div>
              </div>
            </div>

            <div class={`lg:col-span-4 ${isReversed ? 'lg:order-1' : 'lg:order-2'}`}>
              <div class="space-y-4">
                <span class="text-xs font-mono font-bold uppercase tracking-[0.3em] text-[#C7FF00] block">
                  {story.tag}
                </span>

                <h2 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold uppercase font-headline tracking-tight text-[#F5F5F2]">
                  {story.title}
                </h2>

                <p class="text-base text-[#8E8E93] font-light leading-relaxed">
                  {story.description}
                </p>
              </div>
            </div>
          </div>
        );
      })}
    </section>

    <!-- 3. Bottom Conversion Action -->
    <section class="px-4 sm:px-8 lg:px-16 py-24 max-w-7xl mx-auto border-t border-white/10 text-center">
      <div class="max-w-3xl mx-auto space-y-6">
        <span class="text-xs font-mono font-bold tracking-[0.3em] text-[#C7FF00] uppercase">
          EXPERIENCE IT LIVE
        </span>
        <h2 class="text-6xl sm:text-8xl md:text-9xl font-extrabold uppercase font-headline text-[#F5F5F2] leading-[0.82]">
          READY TO PLAY?
        </h2>
        <p class="text-base sm:text-xl text-[#8E8E93] font-light max-w-md mx-auto">
          Lock in your match session under the floodlights at Beniya Cricket Arena.
        </p>

        <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
          <a
            href={contactConfig.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary text-xs sm:text-sm"
          >
            <span>WHATSAPP TO BOOK</span>
            <span>→</span>
          </a>

          <a
            href={contactConfig.phoneHref}
            class="btn-secondary text-xs sm:text-sm"
          >
            <span>CALL NOW</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <MobileBookingBar />
</Layout>
