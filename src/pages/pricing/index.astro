---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import MobileBookingBar from '../../components/MobileBookingBar.astro';
import { contactConfig, seoConfig, pricingTiers } from '../../data/siteConfig';
---

<Layout
  title={seoConfig.pages.pricing.title}
  description={seoConfig.pages.pricing.description}
  keywords={seoConfig.pages.pricing.keywords}
>
  <Navbar />

  <main class="pt-32 pb-20">
    <!-- 1. Hero -->
    <section class="px-4 sm:px-8 lg:px-16 py-12 max-w-7xl mx-auto">
      <div class="space-y-4 max-w-3xl">
        <span class="text-xs font-mono uppercase tracking-[0.3em] text-[#C7FF00] block">
          TRANSPARENT HOURLY RATES · VARANASI
        </span>
        <h1 class="text-6xl sm:text-8xl md:text-9xl font-extrabold uppercase font-headline tracking-tighter text-[#F5F5F2] leading-[0.82]">
          TURF PRICES.
        </h1>
        <p class="text-xl sm:text-2xl text-[#8E8E93] font-light pt-2">
          Simple hourly pricing. Contact the arena to confirm current rates and availability.
        </p>
      </div>
    </section>

    <!-- 2. Pricing Grid -->
    <section class="px-4 sm:px-8 lg:px-16 py-12 max-w-7xl mx-auto border-t border-white/10">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 items-stretch">
        {pricingTiers.map((tier) => (
          <div
            class={`rounded-3xl p-8 sm:p-10 flex flex-col justify-between transition-luxury ${
              tier.isPopular
                ? 'bg-[#141414] border-2 border-[#C7FF00] shadow-[0_0_35px_rgba(199,255,0,0.12)]'
                : 'bg-[#111111] border border-white/10'
            }`}
          >
            <div>
              <div class="text-xs font-mono font-bold tracking-widest text-[#8E8E93] uppercase">
                {tier.title} SESSION
              </div>

              <div class="mt-6 flex items-baseline gap-1">
                <span class="text-2xl font-mono text-[#8E8E93]">₹</span>
                <span class="text-6xl sm:text-7xl font-extrabold font-headline tracking-tight text-[#F5F5F2]">
                  {tier.price}
                </span>
                <span class="text-xs font-mono text-[#8E8E93] ml-1 uppercase">
                  / {tier.priceUnit}
                </span>
              </div>
            </div>

            <div class="mt-10 pt-6 border-t border-white/5 flex flex-col gap-3">
              <a
                href={contactConfig.whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class={`w-full py-4 rounded-full text-xs font-extrabold uppercase tracking-widest flex items-center justify-center gap-2 transition-all ${
                  tier.isPopular
                    ? 'bg-[#C7FF00] text-[#080808] hover:bg-[#D4FF33]'
                    : 'bg-white/5 text-white hover:bg-white/10 border border-white/10'
                }`}
              >
                <span>WHATSAPP TO BOOK</span>
                <span>→</span>
              </a>

              <a
                href={contactConfig.phoneHref}
                class="w-full py-2.5 text-center text-xs font-mono uppercase tracking-wider text-[#8E8E93] hover:text-white transition-colors"
              >
                CALL TO RESERVE →
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. Direct Reservation Notice -->
    <section class="px-4 sm:px-8 lg:px-16 py-16 max-w-7xl mx-auto border-t border-white/10">
      <div class="p-8 sm:p-12 rounded-3xl bg-[#111111] border border-white/10 flex flex-col md:flex-row md:items-center justify-between gap-8">
        <div class="max-w-2xl space-y-2">
          <span class="text-[10px] font-mono font-bold tracking-widest text-[#C7FF00] uppercase">
            BOOKING INFORMATION
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold uppercase font-headline text-white">
            CUSTOM MATCH SESSIONS & TOURNAMENTS
          </h2>
          <p class="text-sm text-[#8E8E93] font-light leading-relaxed">
            Planning a multi-hour tournament or regular team booking? Contact the arena directly on WhatsApp or Call for scheduling.
          </p>
        </div>

        <div class="flex-shrink-0 flex items-center gap-3">
          <a
            href={contactConfig.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary text-xs"
          >
            <span>WHATSAPP TO BOOK →</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <MobileBookingBar />
</Layout>
